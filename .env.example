# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase project settings -> Database -> Connection string (session pooler, port 5432). Used by scripts only.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
